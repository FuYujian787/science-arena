# ============================================================
# Science Arena 配置样例：复制为 .env 并填入自己的密钥
# ============================================================

# LLM 后端：deepseek（直连）| dify（走 Dify 应用）| mock（离线干跑）
LLM_PROVIDER=deepseek

# ---------- DeepSeek 直连 ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_MAX_TOKENS=6000
DEEPSEEK_EFFORT=low

# 单次模型请求的静默超时（毫秒）
LLM_TIMEOUT_MS=180000

# ---------- Dify 应用 ----------
DIFY_BASE_URL=https://dify.zju.edu.cn
DIFY_APP_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 服务 ----------
PORT=3010

# ---------- 辩论参数 ----------
CROSS_ROUNDS=2

# ---------- RAG 证据检索 ----------
# pubmed：去 PubMed 取真实文献摘要，每条证据带 PMID，可点开核对原文（默认）
# none  ：不检索，全部用模型知识并强制标注（断网 / 离线演示时用这个）
RAG_PROVIDER=pubmed
# 一场辩论取几条文献
RAG_TOP_K=5
# 单次检索超时（毫秒）。超时会自动回退到模型知识，不会让整场辩论失败
RAG_TIMEOUT_MS=20000

# ============================================================
# 以下只在「部署到服务器 / 公开访问」时才需要（详见 部署指南.md）
# 本地跑用不到，可以整段留着不管
# ============================================================

# ---------- 反向代理 + 自动 HTTPS（docker compose --profile proxy）----------
# 必填：你的域名，需先解析到这台服务器
# DOMAIN=arena.example.edu.cn

# 强烈建议填：这个应用本身没有登录，公开后谁都能用、也就能消耗你的 API Key。
# 在反向代理层加一道基础认证是最省事也最有效的方式。
# 哈希用这条命令生成：docker run --rm caddy caddy hash-password --plaintext '你的密码'
# BASIC_AUTH_USER=arena
# BASIC_AUTH_HASH=$2a$14$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

